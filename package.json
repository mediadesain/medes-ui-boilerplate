{
  "name": "medes-ui-boilerplate",
  "version": "2.0.0-beta.11",
  "scripts": {
    "ng": "ng",
    "start": "ng lint medes-ui-boilerplate && ng serve medes-ui-boilerplate --port 4600",
    "start:production": "ng lint medes-ui-boilerplate && ng serve medes-ui-boilerplate --port 4800 --configuration production",
    "build": "ng build medes-ui-boilerplate --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "build:lib": "npm run build:lib-core && npm run build:lib-angular && npm run build:lib-react && npm run update:lib",
    "build:lib-core": "ng build medes-ui --configuration production",
    "build:lib-angular": "ng build medes-ui-angular --configuration production",
    "build:lib-react": "ng build medes-ui-react --configuration production && npm run update:lib-react",
    "publish:lib-beta": "npm run publish:lib-beta-core && npm run publish:lib-beta-angular && npm run publish:lib-beta-react",
    "publish:lib-beta-core": "cd dist/@medes-ui/core && npm publish --tag beta --access=public",
    "publish:lib-beta-angular": "cd dist/@medes-ui/angular && npm publish --tag beta --access=public",
    "publish:lib-beta-react": "cd dist/@medes-ui/react && npm publish --tag beta --access=public",
    "update:lib": "rm -rf node_modules/@medes-ui && cp -R dist/@medes-ui node_modules/",
    "update:lib-react": "rm -rf /Volumes/Data/Project/Development/website/React/mds-app/node_modules/@medes-ui && cp -R dist/medes-ui /Volumes/Data/Project/Development/website/React/mds-app/node_modules"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.14",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@angular/router": "^19.2.14",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@medes-ui/core": "2.0.0-beta.11",
    "@medes-ui/angular": "2.0.0-beta.11",
    "@medes-ui/react": "2.0.0-beta.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.3.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^8.0.0",
    "jasmine-core": "~4.0.1",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^19.2.2",
    "ts-node": "~8.3.0",
    "typescript": "~5.8.3"
  }
}
